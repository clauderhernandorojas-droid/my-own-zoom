PORT=3000
NODE_ENV=development
JWT_SECRET=cambia_esto_en_produccion
DATABASE_URL=
# Si DATABASE_URL está vacío, se usa SQLite en ./data/app.sqlite
# Umbral de copresencia en ms (3600000 ≈ 60 min; 30000 para pruebas)
ASISTENCIA_COPRESENCIA_MS_MIN=3600000
# Asistencia en vivo: eventos attendance:* y flush anticipado al umbral (true/false)
ASISTENCIA_LIVE_ENABLED=false
# Métricas en GET .../asistencia/reporte: chat (BD), session/full (RAM copresencia/docente)
# Query: metrics=0|chat|session|full — requiere ASISTENCIA_METRICAS_ENABLED=true
ASISTENCIA_METRICAS_ENABLED=false
# Persistencia Fase C: flush métricas sesión en reunion_asistencia_ms (true/false)
ASISTENCIA_PERSISTENCE_ENABLED=false
