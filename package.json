{
  "name": "my-own-zoom",
  "version": "0.1.0",
  "description": "Plataforma de videoconferencias pedagógicas (MVP)",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test:copresencia": "node scripts/test-copresencia-socket.cjs",
    "test:waiting-room": "node scripts/test-waiting-room-socket.cjs",
    "test:room-expel": "node scripts/test-room-expel-socket.cjs",
    "test:screen-share-stop": "node scripts/test-screen-share-stop-socket.cjs",
    "test:screen-share-auth": "node scripts/test-screen-share-auth-socket.cjs",
    "test:screenshare-annotate": "node scripts/test-screenshare-annotate-socket.cjs",
    "test:annotation-overlay-core": "node scripts/test-annotation-overlay-core.cjs",
    "test:app-state": "node scripts/test-app-state.cjs",
    "test:chat": "node scripts/test-chat-toggle.cjs",
    "test:chat-badge": "node scripts/test-chat-badge.cjs",
    "test:participants": "node scripts/test-participants-panel.cjs",
    "test:screen-share": "node scripts/test-screen-share.cjs && node scripts/test-screen-share-stop-socket.cjs && node scripts/test-screen-share-auth-socket.cjs",
    "test:room-modules": "npm run test:app-state && npm run test:chat && npm run test:chat-badge && npm run test:participants && node scripts/test-web-layout-modules.cjs && node scripts/test-gallery-video-mosaic.cjs && node scripts/test-screen-share.cjs && node scripts/test-chat-socket-bridge.cjs && node scripts/test-share-socket-bridge.cjs && node scripts/test-share-ownerid-layout.cjs && node scripts/test-mini-player-suppression.cjs",
    "test:asistencia-ms": "node scripts/test-reunion-asistencia-ms-unit.cjs",
    "validate:phase-c": "node scripts/validate-phase-c-debug.cjs",
    "electron:start": "cross-env MOJ_ELECTRON_NO_FORK=1 MOJ_ELECTRON_NO_RELOAD=1 electron .",
    "electron:desktop": "cross-env MOJ_ELECTRON_EMBED_SERVER=1 MOJ_ELECTRON_NO_RELOAD=1 electron .",
    "electron:dev": "node scripts/electron-dev.cjs",
    "electron:dev:hot": "cross-env MOJ_ELECTRON_NO_FORK=1 MOJ_ELECTRON_RELOAD=1 electron .",
    "electron-start": "npm run electron:start"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "pg": "^8.21.0",
    "sequelize": "^6.37.5",
    "socket.io": "^4.8.1",
    "sqlite3": "^5.1.7",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.3.0",
    "electron-reload": "^2.0.0-alpha.1",
    "socket.io-client": "^4.8.3",
    "wait-on": "^8.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clauderhernandorojas-droid/my-own-zoom.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/clauderhernandorojas-droid/my-own-zoom/issues"
  },
  "homepage": "https://github.com/clauderhernandorojas-droid/my-own-zoom#readme"
}
